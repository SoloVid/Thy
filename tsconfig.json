{
  "ts-node": {
    // It is faster to skip typechecking.
    "transpileOnly": true
  },
  "compilerOptions": {
    "lib": ["es2021"],
    "module": "commonjs",
    "target": "es2021",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": "src",
    "paths": {
      "thy-lang": ["./api/index"],
      "thy-lang/*": ["./api/*"],
      "test-framework": ["./utils/test-entrypoint"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
