{
  "name": "thy-lang",
  "version": "0.1.0",
  "description": "Simple language for thy mobile programming",
  "exports": {
    ".": "./lib/api/index.js",
    "./std-lib": "./lib/api/std-lib.js",
    "./utils": "./lib/api/utils.js"
  },
  "bin": {
    "thy": "bin/thy"
  },
  "files": [
    "README.md",
    "package.json",
    "bin/*",
    "lib/api/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "sh -c 'esbuild src/api/*.ts --bundle --platform=node --outdir=lib/api'",
    "check-types": "tsc --noEmit",
    "clean": "node -p \"require('fs').rmSync('lib',{force:true,recursive:true})\"",
    "format": "prettier --no-semi . --write",
    "generate-declarations": "tsc --emitDeclarationOnly",
    "site:build": "node -r esbuild-register src/build/build-site.ts",
    "site:dev": "nodemon -r esbuild-register src/build/dev-site.ts",
    "site:dev:node-experimental": "node --experimental-strip-types --watch src/build/dev-site.ts",
    "interpret": "node -r esbuild-register src/interpreter/cli.ts",
    "serve": "node -r esbuild-register src/editor/server.ts",
    "start": "node lib/index.js",
    "test:mocha": "mocha -r esbuild-register",
    "test:uts": "uts -r esbuild-register src",
    "test": "npm run -s test:uts",
    "test:coverage": "nyc --reporter=lcov --reporter=text-summary npm run test",
    "test:watch": "watchlist --eager src -- npm run test:coverage"
  },
  "author": "Grant Dennison",
  "license": "MIT",
  "dependencies": {
    "@babel/code-frame": "^7.16.7",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@isomorphic-git/lightning-fs": "^4.6.1",
    "@stitches/react": "^1.2.8",
    "chalk": "^4.1.2",
    "glob": "^8.0.1",
    "goober": "^2.1.16",
    "lz-string": "^1.5.0",
    "mutative": "^1.0.11",
    "prismjs": "^1.29.0",
    "yargs": "^17.4.1"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.0.3",
    "@types/glob": "^7.2.0",
    "@types/isomorphic-git__lightning-fs": "^4.4.8",
    "@types/jest": "^27.0.2",
    "@types/mocha": "^10.0.8",
    "@types/node": "^16",
    "@types/prismjs": "^1.26.0",
    "@types/prop-types": "^15.7.14",
    "@types/yargs": "^17.0.10",
    "async-mutex": "^0.5.0",
    "chokidar": "^3.5.3",
    "esbuild": "~0.25",
    "esbuild-register": "^3.6",
    "expect": "^28.1.3",
    "markdown-to-jsx": "^7.3.2",
    "marked": "^16.4.1",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "nyc": "^15.1.0",
    "preact": "^10",
    "prettier": "~3.3",
    "prop-types": "^15.8.1",
    "styled-components": "^6.1.13",
    "tmp-promise": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9",
    "under-the-sun": "^2.1.1",
    "watchlist": "^0.3.1"
  }
}
